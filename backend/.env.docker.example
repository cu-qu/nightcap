# Copy to .env for local Docker / Dev Containers (post-create does this automatically).
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True

POSTGRES_DB=night_cap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DJANGO_SETTINGS_MODULE=config.settings.local
CORS_ALLOW_ALL_ORIGINS=true

# Optional: transactional email (defaults to console backend when unset)
# RESEND_API_KEY=
# DEFAULT_FROM_EMAIL=NightCap <hello@nightcap.app>

# Cloudflare R2 (optional locally; production uses it when credentials are set)
