# Copy to .env for local Docker / Dev Containers (post-create does this automatically).
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True

POSTGRES_DB=night_cap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DJANGO_SETTINGS_MODULE=config.settings.local
CORS_ALLOW_ALL_ORIGINS=true

# Optional: transactional email (defaults to console backend when unset)
# RESEND_API_KEY=
# DEFAULT_FROM_EMAIL=NightCap <hello@nightcap.app>

# Billing / IAP
# IAP_TRIAL_DAYS=30
# IAP_APPLE_BUNDLE_ID=com.nightcap.app
# IAP_GOOGLE_PACKAGE_NAME=com.nightcap.app
# IAP_APPLE_VERIFY_SIGNATURE=true
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=  # path or inline service-account JSON
# IAP_STAFF_COMPLIMENTARY=false
